// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  password      String
  name          String?
  agencyName    String?
  credits       Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Subscription model (Stripe)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?         // "active" | "canceled" | "past_due" | "incomplete" | null
  subscriptionPlan     String?         // "starter" | "pro" | "agency" | null
  articlesLimitPerMonth Int           @default(0)
  articlesUsedThisMonth Int           @default(0)
  billingCycleStart    DateTime?
  billingCycleEnd      DateTime?

  defaultLanguage      String  @default("es")
  defaultTone          String  @default("professional")

  wordpressUrl         String?
  wordpressUsername    String?
  wordpressPassword    String?
  wordpressConnected   Boolean @default(false)

  articles         Article[]
  creditPurchases  CreditPurchase[]
  voiceProfiles    VoiceProfile[]
  clients          Client[]
  generationJobs   GenerationJob[]

  @@map("users")
}

model Article {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  content       String
  keywords      String
  companyName   String
  companyType   String
  metaDescription String?
  readingTime   Int?

  downloadedAt  DateTime?
  wordpressPostId      Int?
  wordpressPostUrl     String?
  publishedToWp      Boolean @default(false)
  publishedToWpAt      DateTime?

  voiceProfileId     String?
  voiceProfile       VoiceProfile? @relation(fields: [voiceProfileId], references: [id])
  clientId           String?
  client             Client?       @relation(fields: [clientId], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, clientId])
  @@index([userId, publishedToWp])
  @@map("articles")
}

model CreditPurchase {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSessionId String?
  amount        Int             // Número de créditos
  price         Float           // Precio en USD
  status        String          @default("pending") // pending, completed, failed

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("credit_purchases")
}

model GenerationJob {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      String    @default("queued")   // "queued" | "running" | "completed" | "failed"
  progress    Int       @default(0)          // 0-100
  totalItems  Int       @default(1)
  doneItems   Int       @default(0)

  // Input payload stored as JSON for the Inngest function
  payload     Json

  // Output: array of saved article IDs
  resultIds   Json?

  error       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("generation_jobs")
}

model VoiceProfile {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  styleGuide    String
  sampleCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  articles      Article[]

  @@map("voice_profiles")
}

model Client {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  companyType   String    @default("SaaS")
  defaultTone   String    @default("professional")
  defaultLanguage String  @default("es")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  articles      Article[]

  @@map("clients")
}
